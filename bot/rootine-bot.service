[Unit]
Description=Rootine support bot (QRIS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rootine-bot
EnvironmentFile=/home/ubuntu/rootine-bot/.env
ExecStart=/usr/bin/python3 /home/ubuntu/rootine-bot/rootine-bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
